# Firebird Configuration
FIREBIRD_HOST=localhost
FIREBIRD_DATABASE=/firebird/data/sample_database.fdb
FIREBIRD_USER=sysdba
FIREBIRD_PASSWORD=masterkey

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sample_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mypassword

# Disposable test databases (used by live regression tests via
# tests/db_isolation.py — never point these at production data)
TEST_FB_HOST=localhost
TEST_FB_DATABASE=/firebird/data/firebird2postgres_test.fdb
TEST_FB_USER=sysdba
TEST_FB_PASSWORD=masterkey
TEST_PG_HOST=localhost
TEST_PG_PORT=5432
TEST_PG_DB=firebird2postgres_test
TEST_PG_USER=postgres
TEST_PG_PASSWORD=mypassword

# Mandatory integration stage: when 1, unavailable live test databases
# fail instead of skipping (set in .github/workflows/ci.yml)
# REQUIRE_INTEGRATION=1
